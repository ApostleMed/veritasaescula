# Netlify environment variables for the ALMA diagnostic registration (netlify/functions).
# Set the real values in Netlify: Site configuration -> Environment variables.
# Never commit real values: this repository is public.
BREVO_KEY=                      # Brevo SMTP key (Brevo -> SMTP & API -> SMTP keys)
BREVO_SMTP_LOGIN=               # Brevo SMTP login shown on the same page, e.g. 1a2b3c001@smtp-brevo.com
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SENDER_EMAIL=admissions@veritasaescula.com
BREVO_SENDER_NAME=Veritas Aescula Institute (VAI)
BREVO_BCC_EMAIL=                # admissions copy of every ticket email
PASS_SIGNING_SECRET=            # long random string, e.g. output of: openssl rand -hex 32
